rules_version = '2';
// Publish in Firebase Console → Storage → Rules
// Without this, screenshot/audio uploads hang or fail and evidence won't appear.
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /recordings/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*|video/.*|application/octet-stream');
    }
  }
}
