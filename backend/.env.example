PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=sentinelx-dev-secret-change-me
JWT_EXPIRES_IN=8h

# Firebase Authentication + Realtime Database (optional — leave blank to run
# on the legacy mock-JWT demo accounts instead). No service account required.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# OpenRouter — powers the real "AI Threat Analyst" (text) and the visual
# consistency check (vision) on video-call frames. Optional; everything runs
# fine without it, just without the LLM-generated insight cards. Defaults to
# genuinely free (":free") models, so this costs $0 to run.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# FraudIntel India — real crowd-sourced Indian fraud intelligence DB (phone
# numbers / UPI IDs / text mentioned in a live call). Optional; live sessions
# work without it, just without the entity-risk lookups. Free "Developer" tier:
# 100 API calls/day, forever free, no card. Get a key at https://www.fraudintel.in
FRAUDINTEL_API_KEY=

# Reality Defender — real deepfake / voice-clone detection API for audio and
# image samples captured during a live session. Optional. Free tier: 50
# scans/month, no card required. Get a key at https://realitydefender.com/api
REALITYDEFENDER_API_KEY=

# Groq — free Whisper speech-to-text used ONLY for "Analyze a recorded call"
# (uploading an audio file you already recorded, as opposed to the Live Mic
# Session which transcribes live via the browser). Optional. Free tier: no
# card, 20 req/min, 8 hours of audio/day, 25MB/file. Get a key (instant, no
# card) at https://console.groq.com/keys
GROQ_API_KEY=
